{
  "name": "i18n-overlay",
  "displayName": "i18n Overlay",
  "description": "Overlay translations for type-safe i18n format",
  "version": "0.0.2",
  "packageManager": "bun@latest",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "i18n Overlay",
      "properties": {
        "i18nOverlay.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable translation overlays"
        },
        "i18nOverlay.localeFiles": {
          "type": "array",
          "default": ["**/locales/**/*.json"],
          "description": "Glob patterns for locale files"
        },
        "i18nOverlay.defaultLocale": {
          "type": "string",
          "default": "en",
          "description": "Default locale to display"
        },
        "i18nOverlay.annotationDelimiter": {
          "type": "string",
          "default": "🌐 ",
          "description": "Delimiter between key and translation"
        },
        "i18nOverlay.useFileNameAsNamespace": {
          "type": "boolean",
          "default": true,
          "description": "Treat file names (or parent directory names) as namespaces for translations"
        },
        "i18nOverlay.defaultNamespace": {
          "type": "string",
          "default": "common",
          "description": "Default namespace to use when no namespace is provided in code or file name"
        },
        "i18nOverlay.maxHintLength": {
          "type": "number",
          "default": 50,
          "description": "Maximum length for inlay hint text. Text longer than this will be truncated with ellipsis. Set to 0 to disable truncation."
        },
        "i18nOverlay.allowedFileTypes": {
          "type": "array",
          "default": ["javascript", "typescript", "javascriptreact", "typescriptreact"],
          "description": "File types (language IDs) where translation lambda detection should be active. Set to empty array to enable for all file types."
        }
      }
    },
    "commands": [
      {
        "command": "i18nOverlay.reload",
        "title": "i18n Overlay: Reload Translations"
      },
      {
        "command": "i18nOverlay.showLogs",
        "title": "i18n Overlay: Show Debug Logs"
      },
      {
        "command": "i18nOverlay.insertTFunction",
        "title": "i18n Overlay: Insert Translation Function"
      },
      {
        "command": "i18nOverlay.extractStringToLocale",
        "title": "i18n Overlay: Extract String to Locale Files"
      },
      {
        "command": "i18nOverlay.addMissingTranslation",
        "title": "i18n Overlay: Add Missing Translation"
      },
      {
        "command": "i18nOverlay.addTranslationToLocale",
        "title": "i18n Overlay: Add Translation to Locale"
      },
      {
        "command": "i18nOverlay.goToTranslation",
        "title": "i18n Overlay: Go to Translation in File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "build": "vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^3.7.1"
  }
}
